# ─────────────────────────────────────────────────────────────
# SkyPulse Weather App — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# cp .env.example .env

# ── OpenWeatherMap (optional) ─────────────────────────────────
# Free tier: 1000 req/day. Used for: geocoding + AQI data.
# Without it, the app uses Open-Meteo (free, no key needed).
# Get key at: https://openweathermap.org/api
VITE_OWM_API_KEY=

# ── Anthropic Claude (for AI Weather Insights) ────────────────
# Required for the "AI Weather Insights" feature.
# Get key at: https://console.anthropic.com/
# Without it, the app shows static fallback suggestions.
VITE_ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────
# All other weather data comes from Open-Meteo (100% free,
# no account or key required): https://open-meteo.com
# ─────────────────────────────────────────────────────────────
